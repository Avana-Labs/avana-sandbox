# Prettier already respects .gitignore, so only list paths NOT covered there.

# Lockfile (never reformat)
package-lock.json

# Convex-generated code (owned by `convex codegen`)
convex/_generated/

# Local Convex deployment state (ignored via nested .convex/.gitignore, which
# Prettier does not read — the root .gitignore alone does not cover this).
.convex/

# Build/report artifacts not in .gitignore
.next-lighthouse/
dist/
.reports/
coverage/

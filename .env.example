# Public Convex connection
NEXT_PUBLIC_CONVEX_URL=

# Existing SIWE bridge
NEXT_PUBLIC_SIWE_ISSUER=
SIWE_JWT_ISSUER=
SIWE_JWT_PRIVATE_JWK=

# Ask AI (mock mode remains enabled until live credentials are supplied)
ASK_AI_MODEL=gpt-5.6-luna
ASK_AI_USE_MOCKS=true
ASK_AI_MAX_OUTPUT_TOKENS=900

# AI provider (server-side / Convex environment only)
OPENAI_API_KEY=

# Market providers (server-side / Convex environment only)
COINGECKO_API_KEY=
UNISWAP_GRAPH_API_KEY=

# Curve, Balancer, Aave, and DefiLlama currently use public or fixture-backed
# adapters. Add provider credentials here only if the selected production
# endpoints require them.

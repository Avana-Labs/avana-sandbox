# Public Convex connection
NEXT_PUBLIC_CONVEX_URL=
CONVEX_RATE_LIMIT_SECRET=

# Sentry (public DSN — safe for client; get from Project Settings → Client Keys)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: auth token for source map uploads in CI (do not commit real tokens)
SENTRY_AUTH_TOKEN=

# Existing SIWE bridge
NEXT_PUBLIC_SIWE_ISSUER=
SIWE_JWT_ISSUER=
SIWE_JWT_PRIVATE_JWK=

# Ask AI (falls back safely when OPENAI_API_KEY is absent)
ASK_AI_MODEL=gpt-5.6-luna
ASK_AI_MAX_OUTPUT_TOKENS=900

# AI provider (server-side / Convex environment only)
OPENAI_API_KEY=

# Market providers (server-side / Convex environment only).
# Ask AI reads a server-side cache (askAIMarketSnapshots) refreshed by scheduled Convex jobs —
# it never calls these providers per user request. Canonical token prices come from convex/prices.ts;
# this cache stores DefiLlama pool/yield data and Aave lending markets only.
# DefiLlama pools (yields API): override the endpoint or cap how many top-TVL pools are cached (default 250).
ASK_AI_DEFILLAMA_POOLS_URL=
ASK_AI_DEFILLAMA_POOLS_LIMIT=
# Aave markets are read from the public, keyless MCP endpoint (https://mcp.aave.com); no env var required.

# Isolated E2E deployment only; never configure these on production.
AVANA_DEPLOYMENT_ENV=
AVANA_E2E_STAGING=
AVANA_E2E_CONVEX_URL=
AVANA_PRODUCTION_CONVEX_URL=
AVANA_PRODUCTION_SIWE_ISSUER=
AVANA_E2E_PRIVATE_JWK=
AVANA_E2E_SESSION_SECRET=
# Explicit local/staging target allowlist used by dev startup and seeding.
AVANA_DEVELOPMENT_CONVEX_URL=

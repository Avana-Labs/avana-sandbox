# Public Convex connection
NEXT_PUBLIC_CONVEX_URL=

# Existing SIWE bridge
NEXT_PUBLIC_SIWE_ISSUER=
SIWE_JWT_ISSUER=
SIWE_JWT_PRIVATE_JWK=

# Ask AI (falls back safely when OPENAI_API_KEY is absent)
ASK_AI_MODEL=gpt-5.6-luna
ASK_AI_MAX_OUTPUT_TOKENS=900

# AI provider (server-side / Convex environment only)
OPENAI_API_KEY=

# Market providers (server-side / Convex environment only).
# Ask AI reads a server-side cache (askAIMarketSnapshots) refreshed by scheduled Convex jobs —
# it never calls these providers per user request. Token prices come from the canonical DefiLlama
# price cron; the jobs below cover dex pools (Uniswap) and lending markets (Aave).
ASK_AI_DEFILLAMA_URL=
ASK_AI_DEFILLAMA_COINS=
# Uniswap v3 via The Graph gateway: store just the API key; the mainnet subgraph id has a default.
UNISWAP_API_KEY=
ASK_AI_UNISWAP_SUBGRAPH_ID=
# Optional: a full prebuilt gateway URL overrides UNISWAP_API_KEY + subgraph id.
ASK_AI_UNISWAP_GRAPH_URL=
# Aave v3 uses the public, keyless https://api.v3.aave.com/graphql. Set only to override the endpoint.
ASK_AI_AAVE_GRAPH_URL=
# CoinGecko is disabled by default (DefiLlama covers prices). CoinMarketCap is optional / unused.
COINGECKO_API_KEY=
ASK_AI_COINGECKO_URL=
ASK_AI_COINGECKO_IDS=
COINMARKETCAP_API_KEY=

{
  "name": "avana-webapp",
  "version": "0.1.0",
  "private": true,
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "overrides": {
    "basic-ftp": "^5.3.1",
    "ws": "^8.21.0",
    "postcss": "$postcss",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.0"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "last 2 Safari versions"
    ],
    "development": [
      "last 1 Chrome version"
    ]
  },
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "dev:test": "NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=1 npm run dev",
    "dev:turbo": "node scripts/run-next.mjs dev --turbopack",
    "build": "node scripts/run-next.mjs build",
    "dev:clean": "npm run clean && npm run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test tests/e2e/app-audit.spec.ts",
    "test:e2e:browser-soak": "playwright test tests/e2e/browser-session-soak.spec.ts --project=chromium",
    "test:e2e:performance": "playwright test tests/e2e/route-performance.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:stress:engine": "RUN_FULL_APP_STRESS=1 vitest run app/lib/__tests__/full-app-stress.test.ts",
    "test:stress:onboarding": "RUN_ONBOARDING_10K=1 vitest run convex/sandbox-onboarding-10k.test.ts",
    "start": "node scripts/run-next.mjs start",
    "lighthouse:budgets": "node scripts/lighthouse-budgets.mjs",
    "lighthouse:build": "AVANA_NEXT_DIST_DIR=.next-lighthouse NEXT_PUBLIC_LIGHTHOUSE_AUDIT_MODE=1 NEXT_PUBLIC_LIGHTHOUSE_AUDIT_ARTIFACT=1 npm run build",
    "lighthouse:serve": "AVANA_NEXT_DIST_DIR=.next-lighthouse NEXT_PUBLIC_LIGHTHOUSE_AUDIT_MODE=1 NEXT_PUBLIC_LIGHTHOUSE_AUDIT_ARTIFACT=1 npm run start -- --port 3001",
    "lighthouse:gpu": "LH_ENABLE_GPU=1 LH_OUTPUT_DIR=.artifacts/lighthouse-gpu npm run lighthouse:budgets",
    "lighthouse:analyze": "node scripts/analyze-lighthouse-bundles.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-accordion": "1.2.17",
    "@radix-ui/react-dialog": "1.1.20",
    "@radix-ui/react-dropdown-menu": "2.1.21",
    "@radix-ui/react-select": "2.3.4",
    "@radix-ui/react-separator": "1.1.12",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.4",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "convex": "^1.42.3",
    "framer-motion": "^12.42.2",
    "next": "^16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.55.4",
    "wagmi": "^2.19.5",
    "web-vitals": "^4.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "convex-test": "^0.0.54",
    "decimal.js": "^10.6.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lighthouse": "13.4.0",
    "postcss": "8.5.20",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
